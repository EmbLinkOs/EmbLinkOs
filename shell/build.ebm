# /data/src/shell/build.ebm -- v2: THE SHELL REBUILDS THE SHELL (BUILD.md §3).
# Twenty-five units, one link (with TCC's own runtime, libtcc1.o: va_start and
# the 64-bit float conversions are calls under TCC), and DELIBERATELY NO install stanza: shell.elf lives
# in /system/bin, which is sealed -- EmbBuild stages, and ADOPTION is a
# separate act (snapshot, copy, reboot) performed by the system, not by the
# build tool. The staged artifact is verified runnable (-c oracles) before
# anyone considers adopting it.

project: shell

name: main.o
kind: compile
inputs: /data/src/shell/main.c /data/src/shell/lex/lex.h /data/src/shell/parse/parse.h /data/src/shell/eval/eval.h /data/src/shell/sval/sval.h /data/src/shell/value/value.h /data/src/shell/wire/wire.h /data/src/shell/hist/hist.h /data/src/shell/eval/exec.h /data/src/shell/edit/edit.h /data/src/shell/complete/complete.h /data/src/shell/prompt/prompt.h /data/src/shell/prompt/p10k.h /data/src/shell/prompt/prompt_os.h /data/src/shell/prompt/wizard_os.h /system/abi/include/embk.h /system/abi/include/embk_syscall.h
args: /data/apps/tcc/tcc.elf -c -I/data/src/shell -I/system/abi/include /data/src/shell/main.c -o /data/build/out/shell/main.o
output: /data/build/out/shell/main.o

